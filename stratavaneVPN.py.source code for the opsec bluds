import subprocess
import tempfile
import time
import zipfile
from datetime import datetime

# Enforce GUI display server settings
os.environ['QT_QPA_PLATFORM'] = 'xcb'
os.environ['DISPLAY'] = os.environ.get('DISPLAY', ':0')

try:
    from PyQt5.QtWidgets import *
    from PyQt5.QtCore import *
    from PyQt5.QtGui import *
    import requests
    from bs4 import BeautifulSoup
except ImportError:
    print("[!] Missing dependencies. Install with: sudo pacman -S python-pyqt5 python-requests python-beautifulsoup4")
    sys.exit(1)

CONFIG_DIR = os.path.expanduser("~/.vpnbook")
VPNBOOK_URL = "https://www.vpnbook.com"

class CredentialManager:
    @staticmethod
    def fetch_vpnbook_password():
        try:
            headers = {'User-Agent': 'Mozilla/5.0 (X11; Linux x86_64)'}
            res = requests.get(f"{VPNBOOK_URL}/freevpn/openvpn", headers=headers, timeout=8)
            soup = BeautifulSoup(res.text, 'html.parser')
            for li in soup.find_all('li'):
                text = li.get_text()
                if 'Password:' in text:
                    p = text.split(':')[-1].strip().split()[0]
                    if len(p) >= 4:
                        return p
        except Exception:
            pass
        return "3ssumf2"

class VPNWorker(QThread):
    status_signal = pyqtSignal(str, bool)
    log_signal = pyqtSignal(str)
    
    def __init__(self):
        super().__init__()
        self.process = None
        self.running = False
        
    def start_vpn(self, config_path, username, password):
        self.config_path = config_path
        self.username = username
        self.password = password
        self.start()
        
    def run(self):
        auth = tempfile.NamedTemporaryFile(mode='w', delete=False, suffix='.txt')
        auth.write(f"{self.username}\n{self.password}\n")
        auth.close()
        os.chmod(auth.name, 0o600)
        
        log_path = '/tmp/openvpn_gui_active.log'
        if os.path.exists(log_path):
            os.remove(log_path)
            
        cmd = [
            'openvpn',
            '--config', self.config_path,
            '--auth-user-pass', auth.name,
            '--log', log_path,
            '--redirect-gateway', 'def1'
        ]
        
        self.status_signal.emit("Cleaning existing OpenVPN instances...", False)
        subprocess.run(['killall', 'openvpn'], stderr=subprocess.DEVNULL)
        time.sleep(1)
        
        self.status_signal.emit("Launching OpenVPN connection daemon...", False)
        self.process = subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        
        self.running = True
        start_time = time.time()
        last_read_pos = 0
        
        while self.running and (time.time() - start_time) < 45:
            if self.process.poll() is not None:
                break
                
            if os.path.exists(log_path):
                try:
                    with open(log_path, 'r') as f:
                        f.seek(last_read_pos)
                        new_lines = f.readlines()
                        last_read_pos = f.tell()
                        
                        for line in new_lines:
                            line_str = line.strip()
                            if line_str:
                                self.log_signal.emit(line_str)
                            if 'Initialization Sequence Completed' in line_str:
                                self.status_signal.emit("Connected! OpenVPN tunnel is active.", True)
                                return
                            elif 'AUTH_FAILED' in line_str:
                                self.status_signal.emit("Authentication failed. Check user/password.", False)
                                return
                except Exception:
                    pass
            time.sleep(1)
            
        self.status_signal.emit("Connection attempt timed out.", False)
        self.stop()

    def stop(self):
        self.running = False
        if self.process:
            try:
                self.process.terminate()
                self.process.wait(timeout=2)
            except Exception:
                pass
            self.process = None
        subprocess.run(['killall', 'openvpn'], stderr=subprocess.DEVNULL)

