        container.setLayout(main_layout)
        self.setCentralWidget(container)
        
        self.worker.status_signal.connect(self.on_status_update)
        self.worker.log_signal.connect(self.append_log)

    def sync_and_load_files(self):
        os.makedirs(CONFIG_DIR, exist_ok=True)
        self.append_log("Syncing config files from VPNBook...")
        
        try:
            res = requests.get(f"{VPNBOOK_URL}/freevpn/openvpn", timeout=8)
            soup = BeautifulSoup(res.text, 'html.parser')
            for a in soup.find_all('a', href=True):
                if a['href'].endswith('.zip'):
                    link = a['href'] if a['href'].startswith('http') else VPNBOOK_URL + a['href']
                    r = requests.get(link)
                    zpath = os.path.join(CONFIG_DIR, 'bundle.zip')
                    with open(zpath, 'wb') as f:
                        f.write(r.content)
                    with zipfile.ZipFile(zpath, 'r') as z:
                        z.extractall(CONFIG_DIR)
                    os.remove(zpath)
        except Exception as e:
            self.append_log(f"Sync note: {e}")
            
        # Fetch dynamic password
        pwd = CredentialManager.fetch_vpnbook_password()
        self.txt_pass.setText(pwd)
        
        self.reload_file_list()

    def reload_file_list(self):
        self.configs.clear()
        self.file_list.clear()
        
        for root, _, files in os.walk(CONFIG_DIR):
            for f in files:
                if f.endswith('.ovpn'):
                    full_path = os.path.join(root, f)
                    self.configs.append({'name': f, 'path': full_path})
                    
        self.configs = sorted(self.configs, key=lambda x: x['name'])
        for item in self.configs:
            self.file_list.addItem(item['name'])
            
        self.append_log(f"Loaded {len(self.configs)} configuration file(s).")

    def browse_custom_file(self):
        path, _ = QFileDialog.getOpenFileName(self, "Select OpenVPN File", "", "OpenVPN Config (*.ovpn)")
        if path:
            filename = os.path.basename(path)
            self.configs.append({'name': filename, 'path': path})
            self.file_list.addItem(f"[Custom] {filename}")
            self.file_list.setCurrentRow(self.file_list.count() - 1)

    def handle_connect(self):
        item = self.file_list.currentItem()
        if not item:
            self.append_log("Error: Select a profile from the list first.")
            return
            
        selected_text = item.text()
        target_path = None
        for c in self.configs:
            if c['name'] in selected_text:
                target_path = c['path']
                break
                
        if not target_path or not os.path.exists(target_path):
            self.append_log("Error: Config file path does not exist.")
            return
            
        user = self.txt_user.text().strip()
        password = self.txt_pass.text().strip()
        
        self.btn_connect.setEnabled(False)
        self.worker.start_vpn(target_path, user, password)

    def handle_disconnect(self):
        self.worker.stop()
        self.btn_connect.setEnabled(True)
        self.lbl_status.setText("Status: Disconnected")
        self.append_log("OpenVPN tunnel stopped.")

    def on_status_update(self, msg, success):
        self.lbl_status.setText(f"Status: {msg}")
        self.append_log(f"[*] {msg}")
        if success or "timed out" in msg or "failed" in msg.lower():
            self.btn_connect.setEnabled(True)

    def append_log(self, text):
        timestamp = datetime.now().strftime('%H:%M:%S')
        self.log_box.append(f"[{timestamp}] {text}")

def main():
    if os.geteuid() != 0:
        print("[!] OpenVPN requires root permissions for interface/routing changes.")
        print("[!] Run with: sudo python3 openvpn_gui.py")
        sys.exit(1)
        
    app = QApplication(sys.argv)
    window = OpenVPNGUI()
    window.show()
    sys.exit(app.exec_())

if __name__ == '__main__':
    main()
