def kill_openvpn():
    """Cross-platform replacement for the old hardcoded 'killall openvpn' call,
    which doesn't exist on Windows and would raise instead of just failing quietly."""
    try:
        if platform.system() == "Windows":
            subprocess.run(['taskkill', '/IM', 'openvpn.exe', '/F'],
                            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        else:
            subprocess.run(['killall', 'openvpn'], stderr=subprocess.DEVNULL)
    except Exception:
        pass


def is_admin():
    """Cross-platform replacement for os.geteuid(), which doesn't exist on Windows."""
    if platform.system() == "Windows":
        try:
            import ctypes
            return ctypes.windll.shell32.IsUserAnAdmin() != 0
        except Exception:
            return False
    return os.geteuid() == 0


