def _synth_engine_wave(freqs, noise_amt, duration, shape, lfo_rate):
    n = int(SAMPLE_RATE * duration)
    fade_n = max(1, int(SAMPLE_RATE * 0.08))
    out = [0.0] * n
    for i in range(n):
        t = i / SAMPLE_RATE
        v = 0.0
        if shape in ("sine", "square"):
            for f in freqs:
                if shape == "sine":
                    v += math.sin(2 * math.pi * f * t)
                else:
                    v += 1.0 if math.sin(2 * math.pi * f * t) >= 0 else -1.0
            v /= max(1, len(freqs))
            if lfo_rate:
                v *= 0.6 + 0.4 * math.sin(2 * math.pi * lfo_rate * t)
        elif shape == "sweep_up":
            f = freqs[0] * (1 + 2.2 * (i / n))
            v = math.sin(2 * math.pi * f * t)
        elif shape == "sweep_down":
            f = freqs[0] * (1.6 - 1.1 * (i / n))
            v = math.sin(2 * math.pi * max(f, 30) * t)
        elif shape == "noise_decay":
            env = max(0.0, 1.0 - (i / n)) ** 2
            v = random.uniform(-1, 1) * env
        elif shape == "noise_crackle":
            v = random.uniform(-1, 1) if random.random() < 0.15 else 0.0
            v += 0.3 * math.sin(2 * math.pi * freqs[0] * t)
        if noise_amt:
            v = v * (1 - noise_amt) + random.uniform(-1, 1) * noise_amt
        if i < fade_n:
            v *= i / fade_n
        if i > n - fade_n:
            v *= (n - i) / fade_n
        out[i] = v
    peak = max(1e-6, max(abs(x) for x in out))
    if peak > 0.9:
        out = [x / peak * 0.9 for x in out]
    return out


def _write_wav(path, samples):
    with wave.open(path, 'w') as f:
        f.setnchannels(1)
        f.setsampwidth(2)
        f.setframerate(SAMPLE_RATE)
        frames = b''.join(struct.pack('<h', max(-32767, min(32767, int(s * 32767)))) for s in samples)
        f.writeframes(frames)


class SoundEngine:
    """Generates and plays one ambient loop per animation engine. Fully
    self-contained (synthesizes its own audio, no external files/downloads),
    fails silently and disables itself if Qt Multimedia isn't installed."""

    def __init__(self):
        self.available = SOUND_AVAILABLE
        self.muted = False
        self._effects = {}
        self._current = None
        self.sound_dir = os.path.join(CONFIG_DIR, "sounds")
        if self.available:
            try:
                os.makedirs(self.sound_dir, exist_ok=True)
            except Exception:
                self.available = False

    def _ensure_generated(self, mode):
        path = os.path.join(self.sound_dir, f"{mode}.wav")
        if os.path.exists(path):
            return path
        spec = ENGINE_SOUND_SPEC.get(mode)
        if not spec:
            return None
        try:
            samples = _synth_engine_wave(*spec)
            _write_wav(path, samples)
            return path
        except Exception:
            return None

    def _get_effect(self, mode):
        if mode in self._effects:
            return self._effects[mode]
        path = self._ensure_generated(mode)
        if not path:
            return None
        try:
            eff = QSoundEffect()
            eff.setSource(QUrl.fromLocalFile(path))
            eff.setVolume(0.28)
            eff.setLoopCount(QSoundEffect.Infinite)
            self._effects[mode] = eff
            return eff
        except Exception:
            return None

    def play_for_mode(self, mode):
        if not self.available:
            return
        self.stop()
        if self.muted or mode == "none":
            return
        eff = self._get_effect(mode)
        if eff:
            eff.play()
            self._current = eff

    def stop(self):
        if self._current:
            try:
                self._current.stop()
            except Exception:
                pass
            self._current = None

    def toggle_mute(self):
        self.muted = not self.muted
        if self.muted:
            self.stop()
        return self.muted


# =====================================================================
#  ANIMATED BACKGROUND — a full-window canvas painted at ~30fps.
#  Sits BEHIND the actual UI (which becomes translucent in Live mode).
# =====================================================================
class AnimatedBackground(QWidget):
    def __init__(self, parent=None):
        super().__init__(parent)
        self.mode = "none"          # none | particles | ocean | glitch | matrix | aurora | grid
        self.color1 = QColor("#58a6ff")
        self.color2 = QColor("#79c0ff")
        self.bg_color = QColor("#000000")
        self._t = 0.0
        self._particles = []
        self._matrix_cols = []
        self._glitch_bands = []
        self._timer = QTimer(self)
        self._timer.timeout.connect(self._tick)
        self._timer.start(33)  # ~30fps

    def set_theme(self, mode, color1, color2, bg_color):
        self.mode = mode
        self.color1 = QColor(color1)
        self.color2 = QColor(color2)
        self.bg_color = QColor(bg_color)
        self._init_mode_state()
        self.update()

    def _init_mode_state(self):
        w = max(self.width(), 800)
        h = max(self.height(), 600)
        if self.mode == "particles":
            self._particles = [{
                "x": random.uniform(0, w), "y": random.uniform(0, h),
                "vx": random.uniform(-0.3, 0.3), "vy": random.uniform(-0.25, 0.25),
                "r": random.uniform(1.2, 3.2), "phase": random.uniform(0, 6.28),
            } for _ in range(70)]
        elif self.mode == "ocean":
            self._particles = [{
                "x": random.uniform(0, w), "y": random.uniform(h * 0.4, h),
                "vy": random.uniform(0.15, 0.5), "r": random.uniform(1.5, 4.0),
                "phase": random.uniform(0, 6.28),
            } for _ in range(35)]
        elif self.mode == "matrix":
            cols = max(1, w // 18)
            self._matrix_cols = [{
                "y": random.uniform(-h, 0), "speed": random.uniform(2.5, 6.5),
                "len": random.randint(6, 16),
            } for _ in range(cols)]
        elif self.mode == "glitch":
            self._glitch_bands = []
        elif self.mode == "blackhole":
            cx, cy = w / 2, h / 2
            self._particles = [{
                "angle": random.uniform(0, 6.28), "radius": random.uniform(40, max(w, h) * 0.6),
                "speed": random.uniform(0.6, 1.6), "r": random.uniform(1.0, 3.0),
            } for _ in range(220)]
        elif self.mode == "fireworks":
            self._particles = []  # bursts spawn dynamically in _tick
        elif self.mode == "galaxy":
            cx, cy = w / 2, h / 2
            self._particles = [{
                "angle": random.uniform(0, 6.28), "radius": random.uniform(10, max(w, h) * 0.55),
                "arm": random.choice([0, 2.09, 4.19]), "r": random.uniform(1.0, 2.8),
            } for _ in range(320)]
        elif self.mode == "inferno":
            self._particles = [{
                "x": random.uniform(0, w), "y": random.uniform(h * 0.6, h + 40),
                "vy": random.uniform(0.8, 2.2), "sway": random.uniform(0, 6.28),
                "r": random.uniform(2.0, 6.0),
            } for _ in range(140)]
        elif self.mode == "supernova":
            self._particles = [{
                "angle": random.uniform(0, 6.28), "speed": random.uniform(0.6, 2.4),
                "dist": random.uniform(0, 50), "r": random.uniform(1.2, 3.0),
            } for _ in range(240)]
        elif self.mode == "lightning":
            self._particles = []  # bolts spawn dynamically
        elif self.mode == "meteor":
            self._particles = [{
                "x": random.uniform(0, w), "y": random.uniform(-h, 0),
                "speed": random.uniform(6, 14), "trail": [],
            } for _ in range(14)]
        elif self.mode == "vortex":
            cx = w / 2
            self._particles = [{
                "angle": random.uniform(0, 6.28), "radius": random.uniform(20, w * 0.45),
                "y": random.uniform(0, h), "r": random.uniform(1.5, 3.5),
            } for _ in range(150)]
            self._funnel_x = cx
        elif self.mode == "tsunami":
            self._particles = [{
                "x": random.uniform(0, w), "y": h, "vy": random.uniform(0.5, 1.5),
                "r": random.uniform(1.5, 4.0),
            } for _ in range(60)]
        elif self.mode == "shatter":
            self._particles = []
            self._shatter_flash = 0.0

    def resizeEvent(self, event):
        self._init_mode_state()
        super().resizeEvent(event)

    def _tick(self):
        self._t += 0.033
        if self.mode == "particles":
            w, h = self.width(), self.height()
            for p in self._particles:
                p["x"] += p["vx"]
                p["y"] += p["vy"]
                if p["x"] < 0: p["x"] = w
                if p["x"] > w: p["x"] = 0
                if p["y"] < 0: p["y"] = h
                if p["y"] > h: p["y"] = 0
        elif self.mode == "ocean":
            h = self.height()
            for p in self._particles:
                p["y"] -= p["vy"]
                if p["y"] < h * 0.35:
                    p["y"] = self.height()
                    p["x"] = random.uniform(0, self.width())
        elif self.mode == "matrix":
            h = self.height()
            for c in self._matrix_cols:
                c["y"] += c["speed"]
                if c["y"] - c["len"] * 18 > h:
                    c["y"] = random.uniform(-200, 0)
                    c["speed"] = random.uniform(2.5, 6.5)
        elif self.mode == "glitch":
            if random.random() < 0.12:
                w = self.width()
                self._glitch_bands = [{
                    "y": random.uniform(0, self.height()),
                    "h": random.uniform(3, 18),
                    "dx": random.uniform(-30, 30),
                } for _ in range(random.randint(1, 4))]
            else:
                self._glitch_bands = []

        elif self.mode == "blackhole":
            for pt in self._particles:
                pull = 60.0 / max(pt["radius"], 10.0)
                pt["radius"] -= pull * pt["speed"]
                pt["angle"] += 0.03 + pull * 0.01
                if pt["radius"] < 6:
                    pt["radius"] = max(self.width(), self.height()) * 0.6
                    pt["angle"] = random.uniform(0, 6.28)

        elif self.mode == "fireworks":
            if random.random() < 0.08:
                cx = random.uniform(self.width() * 0.15, self.width() * 0.85)
                cy = random.uniform(self.height() * 0.15, self.height() * 0.55)
                burst_color = self.color1 if random.random() < 0.5 else self.color2
                for _ in range(55):
                    ang = random.uniform(0, 6.28)
                    spd = random.uniform(1.0, 4.5)
                    self._particles.append({
                        "x": cx, "y": cy, "vx": math.cos(ang) * spd, "vy": math.sin(ang) * spd,
                        "life": 1.0, "color": burst_color,
                    })
            for pt in self._particles:
                pt["x"] += pt["vx"]
                pt["y"] += pt["vy"]
                pt["vy"] += 0.05  # gravity
                pt["life"] -= 0.018
            self._particles = [p for p in self._particles if p["life"] > 0]

        elif self.mode == "galaxy":
            for pt in self._particles:
                pt["angle"] += 0.012 * (60.0 / max(pt["radius"], 20.0))

        elif self.mode == "inferno":
            h = self.height()
            for pt in self._particles:
                pt["y"] -= pt["vy"]
                pt["sway"] += 0.08
                if pt["y"] < -20:
                    pt["y"] = self.height() + random.uniform(0, 40)
                    pt["x"] = random.uniform(0, self.width())

        elif self.mode == "supernova":
            maxdist = max(self.width(), self.height()) * 0.7
            for pt in self._particles:
                pt["dist"] += pt["speed"]
                if pt["dist"] > maxdist:
                    pt["dist"] = 0
                    pt["angle"] = random.uniform(0, 6.28)

        elif self.mode == "lightning":
            if random.random() < 0.06:
                x0 = random.uniform(self.width() * 0.1, self.width() * 0.9)
                pts = [(x0, 0)]
                x, y = x0, 0
                while y < self.height():
                    x += random.uniform(-40, 40)
                    y += random.uniform(30, 70)
                    pts.append((x, y))
                self._particles = [{"bolt": pts, "life": 1.0}]
            else:
                for p in self._particles:
                    p["life"] -= 0.15
                self._particles = [p for p in self._particles if p["life"] > 0]

        elif self.mode == "meteor":
            h, w = self.height(), self.width()
            for m in self._particles:
                m["x"] += m["speed"] * 0.6
                m["y"] += m["speed"]
                m["trail"].append((m["x"], m["y"]))
                if len(m["trail"]) > 14:
                    m["trail"].pop(0)
                if m["y"] > h + 20 or m["x"] > w + 20:
                    m["x"] = random.uniform(-100, w * 0.6)
                    m["y"] = random.uniform(-h * 0.4, 0)
                    m["speed"] = random.uniform(6, 14)
                    m["trail"] = []

        elif self.mode == "vortex":
            w, h = self.width(), self.height()
            self._funnel_x = w / 2 + math.sin(self._t * 0.4) * w * 0.2
            for pt in self._particles:
                pull = 50.0 / max(pt["radius"], 8.0)
                pt["radius"] -= pull * 0.7
                pt["angle"] += 0.05 + pull * 0.02
                pt["y"] -= 1.2
                if pt["radius"] < 4 or pt["y"] < -20:
                    pt["radius"] = w * 0.45
                    pt["angle"] = random.uniform(0, 6.28)
                    pt["y"] = h + random.uniform(0, 40)

        elif self.mode == "tsunami":
            h = self.height()
            self._wave_phase = self._t * 1.4
            for pt in self._particles:
                pt["y"] -= pt["vy"] * 2
                if pt["y"] < h * 0.15:
                    pt["y"] = h
                    pt["x"] = random.uniform(0, self.width())

        elif self.mode == "shatter":
            if random.random() < 0.02 or getattr(self, "_shatter_flash", 0.0) > 0.9:
                self._shatter_flash = 1.0
                w, h = self.width(), self.height()
                cx, cy = w / 2, h / 2
                self._particles = [{
                    "x": cx, "y": cy,
                    "vx": math.cos(a) * random.uniform(2, 7), "vy": math.sin(a) * random.uniform(2, 7),
                    "life": 1.0,
                } for a in [random.uniform(0, 6.28) for _ in range(50)]]
            self._shatter_flash = max(0.0, getattr(self, "_shatter_flash", 0.0) - 0.03)
            for pt in self._particles:
                pt["x"] += pt["vx"]
                pt["y"] += pt["vy"]
                pt["life"] -= 0.012
            self._particles = [p for p in self._particles if p["life"] > 0]

        self.update()

    def paintEvent(self, event):
        p = QPainter(self)
        p.setRenderHint(QPainter.Antialiasing)
        w, h = self.width(), self.height()
        p.fillRect(self.rect(), self.bg_color)

        if self.mode == "particles":
            for pt in self._particles:
                alpha = 0.25 + 0.55 * (0.5 + 0.5 * math.sin(self._t * 1.3 + pt["phase"]))
                c = QColor(self.color1)
                c.setAlphaF(alpha * 0.9)
                p.setPen(Qt.NoPen)
                p.setBrush(c)
                p.drawEllipse(QPointF(pt["x"], pt["y"]), pt["r"] * 2.2, pt["r"] * 2.2)
                c2 = QColor(self.color1)
                c2.setAlphaF(min(1.0, alpha))
                p.setBrush(c2)
                p.drawEllipse(QPointF(pt["x"], pt["y"]), pt["r"], pt["r"])

        elif self.mode == "ocean":
            for i, (speed, amp, yoff, col) in enumerate([
                (0.6, 26, 0.55, self.color1), (0.9, 18, 0.68, self.color2), (1.3, 12, 0.82, self.color1)
            ]):
                path = QPainterPath()
                path.moveTo(0, h)
                base_y = h * yoff
                step = 12
                x = 0
                path.lineTo(0, base_y)
                while x <= w:
                    y = base_y + amp * math.sin(x * 0.02 + self._t * speed * 2)
                    path.lineTo(x, y)
                    x += step
                path.lineTo(w, h)
                path.closeSubpath()
                c = QColor(col)
                c.setAlphaF(0.20 + 0.08 * i)
                p.setPen(Qt.NoPen)
                p.setBrush(c)
                p.drawPath(path)
            for pt in self._particles:
                c = QColor(self.color2)
                c.setAlphaF(0.35 + 0.25 * math.sin(self._t * 2 + pt["phase"]))
                p.setPen(Qt.NoPen)
                p.setBrush(c)
                p.drawEllipse(QPointF(pt["x"], pt["y"]), pt["r"], pt["r"])

        elif self.mode == "matrix":
            p.setPen(Qt.NoPen)
            for i, c in enumerate(self._matrix_cols):
                x = i * 18 + 4
                for j in range(c["len"]):
                    yy = c["y"] - j * 18
                    if 0 <= yy <= h:
                        alpha = max(0.0, 1.0 - j / c["len"])
                        col = QColor(self.color1)
                        col.setAlphaF(alpha * 0.9 if j > 0 else 1.0)
                        p.setBrush(col)
                        p.drawRect(QRectF(x, yy, 3, 10))

        elif self.mode == "glitch":
            for band in self._glitch_bands:
                y, bh, dx = band["y"], band["h"], band["dx"]
                c1 = QColor(self.color1); c1.setAlphaF(0.35)
                c2 = QColor(self.color2); c2.setAlphaF(0.30)
                p.setPen(Qt.NoPen)
                p.setBrush(c1)
                p.drawRect(QRectF(dx, y, w, bh))
                p.setBrush(c2)
                p.drawRect(QRectF(-dx, y + bh * 0.4, w, bh * 0.6))
            if random.random() < 0.04:
                flash = QColor(self.color1)
                flash.setAlphaF(0.08)
                p.fillRect(self.rect(), flash)

        elif self.mode == "aurora":
            for i, (speed, amp, yoff, col) in enumerate([
                (0.35, h * 0.12, 0.25, self.color1),
                (0.5, h * 0.10, 0.40, self.color2),
                (0.25, h * 0.14, 0.55, self.color1),
            ]):
                path = QPainterPath()
                path.moveTo(0, 0)
                x = 0
                pts = []
                while x <= w:
                    y = h * yoff + amp * math.sin(x * 0.01 + self._t * speed * 2 + i)
                    pts.append((x, y))
                    x += 16
                path.moveTo(0, 0)
                path.lineTo(pts[0][0], pts[0][1])
                for (px, py) in pts:
                    path.lineTo(px, py)
                path.lineTo(w, 0)
                path.closeSubpath()
                c = QColor(col)
                c.setAlphaF(0.10 + 0.05 * i)
                p.setPen(Qt.NoPen)
                p.setBrush(c)
                p.drawPath(path)

        elif self.mode == "grid":
            horizon = h * 0.55
            c = QColor(self.color1)
            c.setAlphaF(0.5)
            pen = QPen(c)
            pen.setWidthF(1.2)
            p.setPen(pen)
            spacing = 46
            offset = (self._t * 40) % spacing
            n_lines = int(h / spacing) + 2
            for i in range(n_lines):
                y = horizon + (i * spacing - offset)
                if y < horizon or y > h:
                    continue
                fade = 1.0 - (y - horizon) / (h - horizon + 1)
                cc = QColor(self.color1)
                cc.setAlphaF(max(0.0, min(0.6, fade)))
                p.setPen(QPen(cc, 1.2))
                p.drawLine(QLineF(0, y, w, y))
            cx = w / 2
            for vx_top in range(-8, 9):
                cc = QColor(self.color2)
                cc.setAlphaF(0.35)
                p.setPen(QPen(cc, 1.0))
                p.drawLine(QLineF(cx, horizon, cx + vx_top * 90, h))
            glow = QRadialGradient(cx, horizon, w * 0.35)
            gc = QColor(self.color2)
            gc.setAlphaF(0.25)
            glow.setColorAt(0.0, gc)
            glow.setColorAt(1.0, QColor(0, 0, 0, 0))
            p.setPen(Qt.NoPen)
            p.setBrush(glow)
            p.drawEllipse(QPointF(cx, horizon), w * 0.35, w * 0.15)

        elif self.mode == "blackhole":
            cx, cy = w / 2, h / 2
            core = QRadialGradient(cx, cy, 70)
            core.setColorAt(0.0, QColor(0, 0, 0, 255))
            edge = QColor(self.color1); edge.setAlphaF(0.8)
            core.setColorAt(0.7, edge)
            core.setColorAt(1.0, QColor(0, 0, 0, 0))
            p.setPen(Qt.NoPen)
            p.setBrush(core)
            p.drawEllipse(QPointF(cx, cy), 90, 90)
            for pt in self._particles:
                x = cx + math.cos(pt["angle"]) * pt["radius"]
                y = cy + math.sin(pt["angle"]) * pt["radius"] * 0.6
                fade = min(1.0, pt["radius"] / 200.0)
                c = QColor(self.color2 if pt["radius"] % 40 < 20 else self.color1)
                c.setAlphaF(0.85 * fade)
                p.setBrush(c)
                p.drawEllipse(QPointF(x, y), pt["r"], pt["r"])
            p.setBrush(QColor(0, 0, 0, 255))
            p.drawEllipse(QPointF(cx, cy), 26, 26)

        elif self.mode == "fireworks":
            for pt in self._particles:
                c = QColor(pt["color"])
                c.setAlphaF(max(0.0, pt["life"]))
                p.setPen(Qt.NoPen)
                p.setBrush(c)
                p.drawEllipse(QPointF(pt["x"], pt["y"]), 2.4, 2.4)

        elif self.mode == "galaxy":
            cx, cy = w / 2, h / 2
            core = QRadialGradient(cx, cy, 60)
            cc = QColor(self.color1); cc.setAlphaF(0.9)
            core.setColorAt(0.0, cc)
            core.setColorAt(1.0, QColor(0, 0, 0, 0))
            p.setPen(Qt.NoPen)
            p.setBrush(core)
            p.drawEllipse(QPointF(cx, cy), 60, 60)
            for pt in self._particles:
                ang = pt["angle"] + pt["arm"]
                x = cx + math.cos(ang) * pt["radius"]
                y = cy + math.sin(ang) * pt["radius"] * 0.55
                fade = 1.0 - min(1.0, pt["radius"] / (max(w, h) * 0.55))
                c = QColor(self.color1 if int(pt["radius"]) % 2 == 0 else self.color2)
                c.setAlphaF(0.25 + 0.5 * fade)
                p.setBrush(c)
                p.drawEllipse(QPointF(x, y), pt["r"], pt["r"])

        elif self.mode == "inferno":
            grad = QLinearGradient(0, h, 0, h * 0.4)
            gc1 = QColor(self.color1); gc1.setAlphaF(0.35)
            gc2 = QColor(self.color2); gc2.setAlphaF(0.0)
            grad.setColorAt(0.0, gc1)
            grad.setColorAt(1.0, gc2)
            p.fillRect(QRectF(0, h * 0.4, w, h * 0.6), grad)
            for pt in self._particles:
                x = pt["x"] + math.sin(pt["sway"]) * 8
                c = QColor(self.color1 if pt["y"] > h * 0.7 else self.color2)
                c.setAlphaF(0.7 * max(0.0, min(1.0, (h - pt["y"]) / h + 0.3)))
                p.setPen(Qt.NoPen)
                p.setBrush(c)
                p.drawEllipse(QPointF(x, pt["y"]), pt["r"], pt["r"] * 1.4)

        elif self.mode == "supernova":
            cx, cy = w / 2, h / 2
            burst = QRadialGradient(cx, cy, 140)
            bc = QColor(self.color1); bc.setAlphaF(0.35 + 0.15 * math.sin(self._t * 3))
            burst.setColorAt(0.0, bc)
            burst.setColorAt(1.0, QColor(0, 0, 0, 0))
            p.setPen(Qt.NoPen)
            p.setBrush(burst)
            p.drawEllipse(QPointF(cx, cy), 160, 160)
            for pt in self._particles:
                x = cx + math.cos(pt["angle"]) * pt["dist"]
                y = cy + math.sin(pt["angle"]) * pt["dist"]
                fade = 1.0 - min(1.0, pt["dist"] / (max(w, h) * 0.7))
                c = QColor(self.color2)
                c.setAlphaF(max(0.0, fade))
                p.setBrush(c)
                p.drawEllipse(QPointF(x, y), pt["r"], pt["r"])

        elif self.mode == "lightning":
            for flash in self._particles:
                bolt = flash["bolt"]
                alpha = max(0.0, flash["life"])
                glow_c = QColor(self.color1); glow_c.setAlphaF(alpha * 0.06)
                p.fillRect(self.rect(), glow_c)
                pen = QPen(QColor(255, 255, 255, int(255 * alpha)))
                pen.setWidthF(2.2)
                p.setPen(pen)
                for i in range(len(bolt) - 1):
                    p.drawLine(QPointF(*bolt[i]), QPointF(*bolt[i + 1]))
                pen2 = QPen(QColor(self.color1)); pen2.setWidthF(5)
                c2 = QColor(self.color1); c2.setAlphaF(alpha * 0.4)
                pen2.setColor(c2)
                p.setPen(pen2)
                for i in range(len(bolt) - 1):
                    p.drawLine(QPointF(*bolt[i]), QPointF(*bolt[i + 1]))

        elif self.mode == "meteor":
            p.setPen(Qt.NoPen)
            for m in self._particles:
                trail = m["trail"]
                for i, (tx, ty) in enumerate(trail):
                    fade = i / max(1, len(trail))
                    c = QColor(self.color1 if i % 2 == 0 else self.color2)
                    c.setAlphaF(0.5 * fade)
                    p.setBrush(c)
                    p.drawEllipse(QPointF(tx, ty), 2.2 * fade + 0.6, 2.2 * fade + 0.6)
                head = QColor(255, 255, 255, 230)
                p.setBrush(head)
                p.drawEllipse(QPointF(m["x"], m["y"]), 2.6, 2.6)

        elif self.mode == "vortex":
            fx = getattr(self, "_funnel_x", w / 2)
            for pt in self._particles:
                x = fx + math.cos(pt["angle"]) * pt["radius"]
                y = pt["y"]
                fade = min(1.0, 1.0 - pt["radius"] / (w * 0.45))
                c = QColor(self.color1 if pt["r"] > 2.5 else self.color2)
                c.setAlphaF(0.25 + 0.55 * fade)
                p.setPen(Qt.NoPen)
                p.setBrush(c)
                p.drawEllipse(QPointF(x, y), pt["r"], pt["r"] * 2.2)

        elif self.mode == "tsunami":
            phase = getattr(self, "_wave_phase", self._t)
            crest_y = h * (0.35 + 0.08 * math.sin(phase * 0.7))
            path = QPainterPath()
            path.moveTo(0, h)
            path.lineTo(0, crest_y)
            x = 0
            while x <= w:
                y = crest_y + 30 * math.sin(x * 0.015 + phase * 2) + 12 * math.sin(x * 0.04 + phase * 3)
                path.lineTo(x, y)
                x += 10
            path.lineTo(w, h)
            path.closeSubpath()
            grad = QLinearGradient(0, crest_y, 0, h)
            c1 = QColor(self.color1); c1.setAlphaF(0.55)
            c2 = QColor(self.color2); c2.setAlphaF(0.25)
            grad.setColorAt(0.0, c1)
            grad.setColorAt(1.0, c2)
            p.setPen(Qt.NoPen)
            p.setBrush(grad)
            p.drawPath(path)
            for pt in self._particles:
                fc = QColor(255, 255, 255, 160)
                p.setBrush(fc)
                p.drawEllipse(QPointF(pt["x"], pt["y"]), pt["r"], pt["r"])

        elif self.mode == "shatter":
            flash = getattr(self, "_shatter_flash", 0.0)
            if flash > 0:
                fc = QColor(255, 255, 255, int(120 * flash))
                p.fillRect(self.rect(), fc)
            cx, cy = w / 2, h / 2
            pen = QPen(QColor(self.color1))
            pen.setWidthF(1.4)
            c = QColor(self.color1); c.setAlphaF(0.5 + 0.5 * flash)
            pen.setColor(c)
            p.setPen(pen)
            for a in range(0, 360, 15):
                rad = math.radians(a)
                p.drawLine(QPointF(cx, cy), QPointF(cx + math.cos(rad) * w * 0.6, cy + math.sin(rad) * h * 0.6))
            p.setPen(Qt.NoPen)
            for pt in self._particles:
                sc = QColor(self.color2)
                sc.setAlphaF(max(0.0, pt["life"]))
                p.setBrush(sc)
                p.drawEllipse(QPointF(pt["x"], pt["y"]), 3, 3)


# =====================================================================
#  SMALL DECORATIVE WIDGETS
# =====================================================================
class PulseDot(QWidget):
    def __init__(self, color="#8b8b96", parent=None):
        super().__init__(parent)
        self.setFixedSize(14, 14)
        self._color = QColor(color)
        self._opacity = 1.0
        self._anim = QPropertyAnimation(self, b"opacity")
        self._anim.setDuration(1400)
        self._anim.setStartValue(1.0)
        self._anim.setKeyValueAt(0.5, 0.35)
        self._anim.setEndValue(1.0)
        self._anim.setLoopCount(-1)
        self._anim.setEasingCurve(QEasingCurve.InOutSine)

    def set_color(self, color, pulsing=True):
        self._color = QColor(color)
        if pulsing:
            if self._anim.state() != QPropertyAnimation.Running:
                self._anim.start()
        else:
            self._anim.stop()
            self._opacity = 1.0
        self.update()

    def get_opacity(self): return self._opacity
    def set_opacity(self, v):
        self._opacity = v
        self.update()
    opacity = pyqtProperty(float, get_opacity, set_opacity)

    def paintEvent(self, event):
        p = QPainter(self)
        p.setRenderHint(QPainter.Antialiasing)
        c = QColor(self._color); c.setAlphaF(self._opacity)
        glow = QColor(self._color); glow.setAlphaF(self._opacity * 0.35)
        p.setPen(Qt.NoPen)
        p.setBrush(glow); p.drawEllipse(0, 0, 14, 14)
        p.setBrush(c); p.drawEllipse(3, 3, 8, 8)


class GlowBar(QWidget):
    def __init__(self, parent=None):
        super().__init__(parent)
        self.setFixedHeight(3)
        self._offset = 0.0
        self._c1 = QColor("#58a6ff")
        self._c2 = QColor("#58a6ff")
        self._anim = QPropertyAnimation(self, b"offset")
        self._anim.setDuration(3000)
        self._anim.setStartValue(0.0)
        self._anim.setEndValue(1.0)
        self._anim.setLoopCount(-1)
        self._anim.setEasingCurve(QEasingCurve.Linear)
        self._anim.start()

    def set_colors(self, c1, c2):
        self._c1, self._c2 = QColor(c1), QColor(c2)
        self.update()

    def get_offset(self): return self._offset
    def set_offset(self, v):
        self._offset = v
        self.update()
    offset = pyqtProperty(float, get_offset, set_offset)

    def paintEvent(self, event):
        p = QPainter(self)
        w = self.width()
        grad = QLinearGradient(0, 0, w, 0)
        pos = self._offset
        grad.setColorAt(max(0.0, pos - 0.25), QColor(0, 0, 0, 0))
        grad.setColorAt(pos, self._c1)
        grad.setColorAt(min(1.0, pos + 0.15), self._c2)
        grad.setColorAt(min(1.0, pos + 0.4), QColor(0, 0, 0, 0))
        p.fillRect(self.rect(), grad)


class LivelyButton(QPushButton):
    """
    Bouncy button. Earlier versions either animated the widget's real
    geometry (which Qt's layout system overrides, so nothing visibly moved)
    or combined a QGraphicsDropShadowEffect with a custom paintEvent on the
    SAME widget — those two fight over who's allowed to paint the widget,
    which is what made it flicker out instead of animating.

    Fix: no graphics effect on this widget at all. Just a scale factor
    applied purely at paint time via a QPainter transform. The widget's
    real size never changes (layout has nothing to fight) and there's no
    competing effect pipeline, so it reliably renders every frame.
    """

    def __init__(self, text, parent=None):
        super().__init__(text, parent)
        self._scale = 1.0
        self._scale_anim = QPropertyAnimation(self, b"btnScale")

    def set_glow_color(self, color):
        # Kept so existing call sites (theme-apply loops) don't need changes.
        # Glow is now expressed via the QSS :hover background-color instead
        # of an animated shadow effect, to avoid the paint conflict above.
        pass

    def get_scale(self): return self._scale
    def set_scale(self, v):
        self._scale = v
        self.update()
    btnScale = pyqtProperty(float, get_scale, set_scale)

    def enterEvent(self, event):
        self._animate_scale(1.045, 140, QEasingCurve.OutBack)
        super().enterEvent(event)

    def leaveEvent(self, event):
        self._animate_scale(1.0, 160, QEasingCurve.OutQuad)
        super().leaveEvent(event)

    def mousePressEvent(self, event):
        self._animate_scale(0.88, 90, QEasingCurve.OutQuad)
        super().mousePressEvent(event)

    def mouseReleaseEvent(self, event):
        target = 1.045 if self.underMouse() else 1.0
        self._animate_scale(target, 420, QEasingCurve.OutElastic)
        super().mouseReleaseEvent(event)

    def _animate_scale(self, target, duration, curve):
        self._scale_anim.stop()
        self._scale_anim.setDuration(duration)
        self._scale_anim.setEasingCurve(curve)
        self._scale_anim.setStartValue(self._scale)
        self._scale_anim.setEndValue(target)
        self._scale_anim.start()

    def paintEvent(self, event):
        if abs(self._scale - 1.0) < 0.001:
            super().paintEvent(event)
            return
        painter = QPainter(self)
        painter.setRenderHint(QPainter.Antialiasing)
        painter.translate(self.width() / 2.0, self.height() / 2.0)
        painter.scale(self._scale, self._scale)
        painter.translate(-self.width() / 2.0, -self.height() / 2.0)
        opt = QStyleOptionButton()
        self.initStyleOption(opt)
        self.style().drawControl(QStyle.CE_PushButton, opt, painter, self)


