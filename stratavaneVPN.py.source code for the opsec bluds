def _hsv_to_hex(h, s, v):
    r, g, b = colorsys.hsv_to_rgb((h % 360) / 360, max(0, min(s, 1)), max(0, min(v, 1)))
    return f"#{int(r * 255):02x}{int(g * 255):02x}{int(b * 255):02x}"


def _hex_to_rgb(hexcolor):
    hexcolor = hexcolor.lstrip('#')
    return tuple(int(hexcolor[i:i + 2], 16) for i in (0, 2, 4))


def _rgba(hexcolor, alpha):
    r, g, b = _hex_to_rgb(hexcolor)
    return f"rgba({r},{g},{b},{alpha})"


def _gen_color_set(seed):
    """Deterministic color family from any seed string -- same seed always
    yields the same colors, used to generate large numbers of distinct
    themes without hand-listing every hex code."""
    rng = random.Random(seed)
    hue = rng.uniform(0, 360)
    sat = rng.uniform(0.65, 1.0)
    val = rng.uniform(0.85, 1.0)
    return {
        "accent": _hsv_to_hex(hue, sat, val),
        "accent_hover": _hsv_to_hex(hue, min(sat + 0.08, 1), min(val + 0.05, 1)),
        "accent2": _hsv_to_hex(hue + rng.choice([30, -30, 150, 180]), sat * 0.85, val),
        "border": _hsv_to_hex(hue, 0.4, 0.3),
    }


