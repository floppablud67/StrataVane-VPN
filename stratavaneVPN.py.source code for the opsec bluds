# =====================================================================
#  SOUND ENGINE — every animation engine gets a short, fully synthesized
#  ambient loop (pure math, no samples/licensed audio — generated once with
#  Python's stdlib `wave` module and cached to disk). Honest disclosure:
#  this is lightweight procedural ambience, not studio sound design.
# =====================================================================
SAMPLE_RATE = 22050

# (frequency layers, noise amount, duration seconds, waveform shape, slow LFO rate or 0)
ENGINE_SOUND_SPEC = {
