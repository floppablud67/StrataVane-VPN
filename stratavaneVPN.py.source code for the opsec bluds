            self.sound.play_for_mode(self.background.mode)

    # ---- theming ----
    def _crossfade(self, apply_fn):
        fade_out = QPropertyAnimation(self.opacity_effect, b"opacity", self)
        fade_out.setDuration(150)
        fade_out.setStartValue(1.0)
        fade_out.setEndValue(0.2)
        fade_out.setEasingCurve(QEasingCurve.InOutQuad)

        fade_in = QPropertyAnimation(self.opacity_effect, b"opacity", self)
        fade_in.setDuration(220)
        fade_in.setStartValue(0.2)
        fade_in.setEndValue(1.0)
        fade_in.setEasingCurve(QEasingCurve.InOutQuad)

        def _mid():
            apply_fn()
            fade_in.start()

        fade_out.finished.connect(_mid)
        self._theme_anim_refs = (fade_out, fade_in)
        fade_out.start()

    def apply_static_theme(self, name, animate=True):
        t = THEMES.get(name)
        if not t:
            return
        self.current_theme = name
        self.is_live_theme = False
        self.live_theme_box.setCurrentIndex(0)
        self.exag_theme_box.setCurrentIndex(0)

        def _apply():
            self.background.set_theme("none", t["accent"], t["accent2"], t["bg"])
            self.setStyleSheet(build_stylesheet(t, translucent=False))
            self.glow_bar.set_colors(t["accent"], t["accent2"])
            for btn in (self.btn_connect, self.btn_browse, self.btn_refresh,
                        self.btn_disconnect, self.btn_visit_site, self.btn_fullscreen):
                btn.set_glow_color(t["accent"])
            self._update_status_dot_color()
            self.sound.stop()

        if animate:
            self._crossfade(_apply)
        else:
            _apply()

    def on_live_theme_changed(self, name):
        if name == "— off —" or name not in LIVE_THEMES:
            return
        spec = LIVE_THEMES[name]
        t = THEMES[spec["base"]]
        self.current_theme = spec["base"]
        self.is_live_theme = True
        self.theme_box.setCurrentText(spec["base"])
        self.exag_theme_box.setCurrentIndex(0)

        def _apply():
            self.background.set_theme(spec["mode"], t["accent"], t["accent2"], t["bg"])
            self.setStyleSheet(build_stylesheet(t, translucent=True))
            self.glow_bar.set_colors(t["accent"], t["accent2"])
            for btn in (self.btn_connect, self.btn_browse, self.btn_refresh,
                        self.btn_disconnect, self.btn_visit_site, self.btn_fullscreen):
                btn.set_glow_color(t["accent"])
            self._update_status_dot_color()
            self.sound.play_for_mode(spec["mode"])

        self._crossfade(_apply)

    def on_exaggerated_theme_changed(self, name):
        if name == "— off —" or name not in EXAGGERATED_THEMES:
            return
        spec = EXAGGERATED_THEMES[name]
        t = THEMES[spec["base"]]
