            QPushButton#btnSecondary { background-color: #21262d; border: 1px solid #30363d; }
            QPushButton#btnSecondary:hover { background-color: #30363d; }
            QTextEdit {
                background-color: #010409;
                color: #3fb950;
                border: 1px solid #30363d;
                border-radius: 6px;
                font-family: monospace;
                font-size: 11px;
            }
        """)
        
        main_layout = QVBoxLayout()
        main_layout.setSpacing(12)
        main_layout.setContentsMargins(15, 15, 15, 15)
        
        # Header Banner
        lbl_header = QLabel("StrataVane VPN")
        lbl_header.setObjectName("appHeader")
        main_layout.addWidget(lbl_header)
        
        # Upper Section: Config Selection
        file_box = QGroupBox("1. Select OpenVPN Profile (.ovpn)")
        file_layout = QVBoxLayout()
        
        self.file_list = QListWidget()
        file_layout.addWidget(self.file_list)
        
        file_btn_layout = QHBoxLayout()
        self.btn_browse = QPushButton("Browse Custom .ovpn File...")
        self.btn_browse.setObjectName("btnSecondary")
        self.btn_browse.clicked.connect(self.browse_custom_file)
        file_btn_layout.addWidget(self.btn_browse)
        
        self.btn_refresh = QPushButton("Fetch / Sync VPNBook Bundles")
        self.btn_refresh.setObjectName("btnSecondary")
        self.btn_refresh.clicked.connect(self.sync_and_load_files)
        file_btn_layout.addWidget(self.btn_refresh)
        
        file_layout.addLayout(file_btn_layout)
        file_box.setLayout(file_layout)
        main_layout.addWidget(file_box)
        
        # Middle Section: Credentials & Controls
        auth_box = QGroupBox("2. Authentication & Connection")
        auth_layout = QHBoxLayout()
        
        auth_layout.addWidget(QLabel("User:"))
        self.txt_user = QLineEdit("vpnbook")
        auth_layout.addWidget(self.txt_user)
        
        auth_layout.addWidget(QLabel("Pass:"))
        self.txt_pass = QLineEdit()
        auth_layout.addWidget(self.txt_pass)
        
        self.btn_connect = QPushButton("CONNECT")
        self.btn_connect.clicked.connect(self.handle_connect)
        auth_layout.addWidget(self.btn_connect)
        
        self.btn_disconnect = QPushButton("DISCONNECT")
        self.btn_disconnect.setObjectName("btnDisconnect")
        self.btn_disconnect.clicked.connect(self.handle_disconnect)
